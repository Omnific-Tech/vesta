{
  "name": "vesta-integration-experiments",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.1"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/setup.ts",
    "probe:claude": "node --experimental-strip-types test/e2e/run.ts claude",
    "probe:codex": "node --experimental-strip-types test/e2e/run.ts codex",
    "verify:evidence": "node --experimental-strip-types test/e2e/acceptance.ts",
    "watch:claude": "node --experimental-strip-types src/cli/watcher-run.ts claude",
    "watch:codex": "node --experimental-strip-types src/cli/watcher-run.ts codex",
    "verify:watcher": "node --experimental-strip-types test/e2e/watcher-acceptance.ts",
    "probe:watcher:claude": "node --experimental-strip-types test/e2e/watcher-live.ts claude",
    "probe:watcher:codex": "node --experimental-strip-types test/e2e/watcher-live.ts codex",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
